"┌ TTNR ────────────────────────────────┐"
"│RSX-11M V4.6 BL56   TTNR V0.1         │"
"│                                      │"
"│┌ KEYS ──────────────────────────────┐│"
"││spc  PLAY / PAUSE                   ││"
"││+ =  VOLUME UP                      ││"
"││-    VOLUME DOWN                    ││"
"││m    MUTE                           ││"
"││n    NEXT STATION                   ││"
"││p    PREVIOUS STATION               ││"
"││s    STATION LIST                   ││"
"││o    OPEN URL                       ││"
"││d    OUTPUT DEVICE                  ││"
"││t    NEXT THEME                     ││"
"││?    HELP                           ││"
"││q    QUIT                           ││"
"││]    TRACK INFO LATER (+1 S)        ││"
"││[    TRACK INFO EARLIER (-1 S)      ││"
"││b    LINE SPEED (TERMINAL THEMES)   ││"
"│└────────────────────────────────────┘│"
"│                                      │"
"│                                      │"
"│SPC PLAY  +/- VOL  ? HELP  Q QUIT     │"
"└──────────────────────────────────────┘"
