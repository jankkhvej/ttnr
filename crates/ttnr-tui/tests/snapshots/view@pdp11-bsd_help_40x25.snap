"+ ttnr --------------------------------+"
"|2.11 BSD UNIX (ttnr) (console)        |"
"|+ keys ------------------------------+|"
"||spc  play / pause                   ||"
"||+ =  volume up                      ||"
"||-    volume down                    ||"
"||m    mute                           ||"
"||n    next station                   ||"
"||p    previous station               ||"
"||s    station list                   ||"
"||o    open URL                       ||"
"||/    search radio-browser           ||"
"||d    output device                  ||"
"||t    next theme                     ||"
"||?    help                           ||"
"||q    quit                           ||"
"||]    track info later (+1 s)        ||"
"||[    track info earlier (-1 s)      ||"
"||i    diagnostics line               ||"
"||b    line speed (terminal themes)   ||"
"|+------------------------------------+|"
"|                                      |"
"|spc play  +/- vol  ? help  q quit     |"
"+--------------------------------------+"
"                                        "
