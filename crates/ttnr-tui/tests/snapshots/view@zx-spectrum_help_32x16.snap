---
source: crates/ttnr-tui/tests/snapshots.rs
---
"spc  play / pause               "
"+ =  volume up                  "
"-    volume down                "
"m    mute                       "
"n    next station               "
"p    previous station           "
"s    station list               "
"o    open URL                   "
"/    search radio-browser       "
"d    output device              "
"t    next theme                 "
"?    help                       "
"q    quit                       "
"]    track info later (+1 s)    "
"[    track info earlier (-1 s)  "
"i    diagnostics line           "
