"┌ TTNR ────────────────────────┐"
"│┌ KEYS ──────────────────────┐│"
"││spc  PLAY / PAUSE           ││"
"││+ =  VOLUME UP              ││"
"││-    VOLUME DOWN            ││"
"││m    MUTE                   ││"
"││n    NEXT STATION           ││"
"││p    PREVIOUS STATION       ││"
"││s    STATION LIST           ││"
"││o    OPEN URL               ││"
"││/    SEARCH RADIO-BROWSER   ││"
"││d    OUTPUT DEVICE          ││"
"││t    NEXT THEME             ││"
"││?    HELP                   ││"
"│└────────────────────────────┘│"
"└──────────────────────────────┘"
